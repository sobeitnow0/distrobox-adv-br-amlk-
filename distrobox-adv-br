[distrobox-adv-br]
image=docker.io/library/debian:trixie
home=~/.distrobox-adv-br
additional_packages="firefox-esr firefox-esr-l10n-pt-br libnss3-tools gvfs"
init_hooks="if [ ! -f /root/.first_run_complete ]; then curl -fsSL https://raw.githubusercontent.com/pedrohqb/distrobox-adv-br/refs/heads/main/scripts/instalar_safesign.sh | sh && curl -fsSL https://raw.githubusercontent.com/pedrohqb/distrobox-adv-br/refs/heads/main/scripts/instalar_safenet.sh | sh && curl -fsSL https://raw.githubusercontent.com/pedrohqb/distrobox-adv-br/refs/heads/main/scripts/instalar_serproid.sh | sh && curl -fsSL https://raw.githubusercontent.com/pedrohqb/distrobox-adv-br/refs/heads/main/scripts/instalar_assinadorserpro.sh | sh && curl -fsSL https://raw.githubusercontent.com/pedrohqb/distrobox-adv-br/refs/heads/main/scripts/instalar_java.sh | sh && curl -fsSL https://raw.githubusercontent.com/pedrohqb/distrobox-adv-br/refs/heads/main/scripts/instalar_pjeoffice.sh | sh && curl -fsSL https://raw.githubusercontent.com/pedrohqb/distrobox-adv-br/refs/heads/main/scripts/instalar_webpki.sh | sh && curl -fsSL https://raw.githubusercontent.com/pedrohqb/distrobox-adv-br/refs/heads/main/scripts/instalar_websigner.sh | sh && curl -fsSL https://raw.githubusercontent.com/pedrohqb/distrobox-adv-br/refs/heads/main/scripts/instalar_certisign.sh | sh && curl -fsSL https://raw.githubusercontent.com/pedrohqb/distrobox-adv-br/refs/heads/main/scripts/configurar_tokens_firefox.sh | sudo -u $USER sh && rm -rf ${HOME}/.distrobox-adv-br/Downloads && sudo -u $USER ln -s ${HOME}/Downloads/ ${HOME}/.distrobox-adv-br && rm ${HOME}/.distrobox-adv-br/.wget-hsts && touch /root/.first_run_complete; fi"
exported_apps="firefox-esr tokenadmin pjeoffice-pro serproid assinador-serpro"
